# ─────────────────────────────────────────────────────────────────────────────
# Passline environment variables
# Copy this file to .env and fill in your credentials.
# All variables are optional — the app starts without credentials but LLM
# calls will fail until credentials are provided.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Cloud / Vertex AI ──────────────────────────────────────────────────
# Set GOOGLE_CLOUD_PROJECT + GOOGLE_CLOUD_LOCATION to use Vertex AI.
# Authentication via Application Default Credentials (gcloud auth login).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ── Gemini API Key (alternative to Vertex AI) ─────────────────────────────────
# Set GOOGLE_API_KEY to use the Gemini API directly (no GCP project needed).
# GOOGLE_API_KEY=your-gemini-api-key

# ── Model selection (optional — sensible defaults are built in) ───────────────
# Override the model used by each agent.
# PASSLINE_LANG_MODEL=gemini-2.5-flash
# PASSLINE_FIXER_MODEL=gemini-2.5-flash
# PASSLINE_COORDINATOR_MODEL=gemini-2.5-flash

# ── Dashboard server ──────────────────────────────────────────────────────────
# Port the dashboard listens on (default: 8000).
# Cloud Run injects PORT automatically; this is only needed for local dev.
# PORT=8000
# PASSLINE_PORT=8000

# ── Event log ─────────────────────────────────────────────────────────────────
# Path to the JSONL event log file.
# Defaults to /tmp/passline_events.jsonl (safe for containers).
# For local dev you may prefer a path in the project root:
# PASSLINE_LOG=passline_events.jsonl
